# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase Edge Function Secrets (set via CLI, NOT in this file) ─────────────
# Run these commands once after creating your Supabase project:
#
#   supabase secrets set ANTHROPIC_KEY=sk-ant-api03-...
#   supabase secrets set FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:...
#
# These secrets are stored in Supabase and never exposed to the browser.
